# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# agent skills (kept local, restore with: npx skills@latest experimental_install)
/.claude/skills/
/.agents/
/agent/
/skills-lock.json

# agent instructions/docs (kept local)
/AGENTS.md
/CLAUDE.md
/docs/agents/

# typescript
*.tsbuildinfo
next-env.d.ts
